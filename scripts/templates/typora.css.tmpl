/* ============================================================
 * {{THEME}} {{VARIANT_LABEL}} — Typora Theme
{{TAGLINE}} * Variant: {{VARIANT_SLUG}}{{MODE_NOTE}}{{CHARACTER}}
 * Version: {{VERSION}}
 * bg: {{hex:bg}}
 * GENERATED by scripts/gen-themes.py from shared/palettes/{{SLUG}}.toml
 * and scripts/templates/typora.css.tmpl — edit those, not this file.
 * ============================================================ */

/* --- Typora UI --- */
:root {
    --side-bar-bg-color:         {{hex:bg-dark}};
    --control-text-color:        {{hex:comment}};
    --bg-color:                  {{hex:bg}};
    --active-file-bg-color:      {{hex:bg-hl}};
    --active-file-text-color:    {{hex:fg}};
    --active-file-border-color:  {{hex:highlight}};
    --item-hover-bg-color:       {{hex:bg-hl}};
    --item-hover-text-color:     {{hex:fg}};
    --search-select-bg-color:    {{SEARCH_SELECT_BG}};   /* current find hit */
    --search-select-text-color:  {{SEARCH_SELECT_TEXT}};
    --control-text-hover-color:  {{hex:fg}};

    /* palette */
{{PALETTE}}
}

/* ============================================================
 * Sidebar / Outline Panel
 * ============================================================ */

.sidebar-tabs   { border-bottom-color: {{c:gutter}}; }
.sidebar-footer { border-top-color:    {{c:gutter}}; }

.outline-item-active .outline-label { font-weight: 600; }
.outline-item:hover { background: {{c:bg-hl}}; color: {{c:fg}}; }
.outline-item:hover .outline-label { text-decoration: underline; }

/* ============================================================
 * Base
 * ============================================================ */

html {
    font-size: 16px;
    -webkit-font-smoothing: antialiased;
    -webkit-print-color-adjust: exact;
    color-adjust: exact;
}

body {
    font-family: "PingFang SC", "Hiragino Sans GB", "Noto Serif SC", Georgia, serif;
    color: {{c:fg}};
    background-color: {{c:bg}};
    line-height: 1.75;
}

#write {
    max-width: 860px;
    margin: 0 auto;
    padding: 2rem 2.5rem 6rem;
    background-color: {{c:bg}} !important;
}

@media only screen and (min-width: 1400px) {
    #write { max-width: 960px; }
}

/* ============================================================
 * Links — cold steel, cyan on hover
 * ============================================================ */

a {
    color: {{c:blue}};
    text-decoration: underline;
    text-underline-offset: 2px;
    text-decoration-color: rgba({{rgb:blue}}, 0.4);
    transition: color 0.15s, text-decoration-color 0.15s;
}

a:hover {
    color: {{c:cyan}};
    text-decoration-color: {{c:cyan}};
}

/* ============================================================
 * Headings
 * ============================================================ */

h1, h2, h3, h4, h5, h6 {
    font-family: "PingFang SC", "Hiragino Sans GB", "SF Pro Display", system-ui, sans-serif;
    font-weight: 600;
    line-height: 1.3;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
}

h1 {
    font-size: 1.75em;
    color: {{c:h1}};
    border-bottom: 2px solid {{c:gutter}};
    padding-bottom: 0.35em;
}

h2 { font-size: 1.5em;  color: {{c:h2}}; }
h3 { font-size: 1.25em; color: {{c:h3}}; }
h4 { font-size: 1.1em;  color: {{c:h4}}; }
h5 { font-size: 1em;    color: {{c:h5}}; }
h6 { font-size: 0.9em;  color: {{c:h6}}; }

h1 .md-tag, h2 .md-tag, h3 .md-tag,
h4 .md-tag, h5 .md-tag, h6 .md-tag {
    color: {{c:comment}};
    font-weight: 400;
}

/* ============================================================
 * Inline emphasis
 * ============================================================ */

p { margin: 0.75rem 0; }

strong { font-weight: 700; }
em     { font-style: italic; }
del    { color: {{c:comment}}; text-decoration: line-through; }
mark   {
    background: {{c:mark-bg}};
    color: {{c:yellow}};
    border-radius: 3px;
    padding: 0 3px;
}

/* ============================================================
 * Code
 * ============================================================ */

code {
    font-family: "JetBrains Mono", "Fira Code", "Cascadia Code", Menlo, Consolas, monospace;
    font-size: 0.875em;
    color: {{c:cyan}};
    background: {{c:bg-hl}};
    padding: 0.15em 0.45em;
    border-radius: 4px;
    border: 1px solid {{c:gutter}};
}

pre, .md-fences {
    font-family: "JetBrains Mono", "Fira Code", "Cascadia Code", Menlo, Consolas, monospace;
    font-size: 0.875em;
    background: {{c:bg-dark}} !important;
    color: {{c:fg}} !important;
    border: 1px solid {{c:gutter}};
    border-radius: 8px;
    padding: 1rem 1.25rem !important;
    margin: 1.25rem 0;
    line-height: 1.6;
    overflow-x: auto;
}

pre code, .md-fences code {
    background: transparent;
    border: none;
    padding: 0;
    color: inherit;
    font-size: inherit;
}

.code-tooltip, .md-fences .code-tooltip {
    background: {{c:bg-hl}} !important;
    color: {{c:comment}} !important;
    border: 1px solid {{c:gutter}} !important;
    border-radius: 4px;
}

/* ============================================================
 * Blockquote — transparent, accent rule (matches the Obsidian version)
 * ============================================================ */

blockquote {
    margin: 1rem 0;
    padding: 0.75rem 1.25rem;
    border-left: 3px solid {{c:accent}};
    background: transparent;
    color: {{c:fg-dim}};
    border-radius: 0 6px 6px 0;
}

blockquote p { margin: 0.3rem 0; }

blockquote blockquote {
    border-left-color: {{c:quote_nested}};
}

/* ============================================================
 * HR
 * ============================================================ */

hr {
    border: none;
    border-top: 1px solid {{c:gutter}};
    margin: 2rem 0;
}

/* ============================================================
 * Tables
 * ============================================================ */

table {
    width: auto;                 /* size to content (Typora's base.css sets 100%), as in Obsidian */
    border-collapse: separate;   /* `separate` so border-radius applies */
    border-spacing: 0;
    margin: 1.25rem 0;
    font-size: 0.875em;          /* 14px at 16px text — same step as code */
    border: 1px solid {{c:gutter}};
    border-radius: 8px;
    overflow: hidden;            /* clip cells to the rounded frame */
}

thead tr { background: {{c:bg-hl}}; }

th, td {
    border: none;
    border-right:  1px solid {{c:gutter}};   /* single internal grid lines */
    border-bottom: 1px solid {{c:gutter}};
}
th:last-child, td:last-child { border-right: none; }
tbody tr:last-child td       { border-bottom: none; }

th {
    padding: 6px 12px;
    text-align: left;
    color: {{c:table_header}};
    font-weight: 600;
    border-bottom: 2px solid {{c:table_header}};
    font-family: "PingFang SC", "Hiragino Sans GB", system-ui, sans-serif;
}

td { padding: 6px 12px; color: {{c:fg}}; vertical-align: top; }

tr:hover td { background: rgba({{rgb:accent}}, {{r:table_hover_alpha}}); }

/* Inline code in cells: same size as the (already smaller) cell text. */
th code, td code { font-size: 1em; }

/* ============================================================
 * Lists
 * ============================================================ */

ul, ol {
    padding-left: 1.75rem;
    margin: 0.5rem 0;
}

li { margin: 0.3rem 0; }
li > ul, li > ol { margin: 0.15rem 0; }

.task-list-item {
    list-style: none;
    margin-left: -1.5rem;
    padding-left: 0;
}

.task-list-item input[type="checkbox"] {
    margin-right: 0.6rem;
    accent-color: {{c:accent}};
}

/* ============================================================
 * Images & Media
 * ============================================================ */

img {
    max-width: 100%;
    border-radius: 6px;
    display: block;
    margin: 1.25rem auto;
}

/* ============================================================
 * Selection
 * ============================================================ */

::selection {
    background: {{c:selection}};
    color: {{c:fg}};
}

/* ============================================================
 * Keyboard / Superscript / Subscript
 * ============================================================ */

kbd {
    font-family: "JetBrains Mono", Menlo, monospace;
    font-size: 0.8em;
    background: {{c:bg-hl}};
    border: 1px solid {{c:gutter}};
    border-bottom: 3px solid {{c:gutter}};
    border-radius: 4px;
    padding: 0.1em 0.5em;
    color: {{c:fg-dim}};
}

sup { color: {{c:blue}}; font-size: 0.75em; }
sub { color: {{c:green}};  font-size: 0.75em; }

/* ============================================================
 * YAML Front Matter
 * ============================================================ */

pre.md-meta-block {
    background: {{c:bg-dark}} !important;
    color: {{c:comment}} !important;
    border: 1px solid {{c:gutter}};
    border-radius: 6px;
    padding: 0.75rem 1rem !important;
    font-size: 0.85em;
    margin-bottom: 2rem;
}

/* ============================================================
 * Footnotes
 * ============================================================ */

.footnotes {
    color: {{c:fg-dim}};
    font-size: 0.85em;
    border-top: 1px solid {{c:gutter}};
    margin-top: 3rem;
    padding-top: 1rem;
}

.footnotes ol { padding-left: 1.25rem; }

/* ============================================================
 * TOC
 * ============================================================ */

.md-toc { color: {{c:fg-dim}}; }
.md-toc-item a {
    color: {{c:blue}};
    border-bottom: none;
}
.md-toc-item a:hover { color: {{c:cyan}}; }

/* ============================================================
 * Math
 * ============================================================ */

.md-math-block, .md-rawblock {
    overflow-x: auto;
}

.MathJax { color: {{c:fg}} !important; }

/* ============================================================
 * Mermaid / Diagrams
 * ============================================================ */

.md-diagram-panel {
    background: {{c:bg-dark}};
    border: 1px solid {{c:gutter}};
    border-radius: 8px;
}

/* ============================================================
 * Source / Edit mode markers
 * ============================================================ */

.md-tag   { color: {{c:comment}}; }
.md-link  { color: {{c:blue}}; }
.md-image { color: {{c:green}}; }

/* ============================================================
 * Syntax Highlighting (highlight.js)
 * Same roles as the Obsidian version: keyword violet, function steel,
 * string moss, property yellow, operator cyan, tag blood, value rust.
 * ============================================================ */

.md-fences .hljs                                                        { color: {{c:fg}}; }
.md-fences .hljs-comment,
.md-fences .hljs-quote                                                  { color: {{c:comment}}; font-style: italic; }
.md-fences .hljs-keyword,
.md-fences .hljs-selector-tag,
.md-fences .hljs-addition                                               { color: {{c:magenta}}; }
.md-fences .hljs-number,
.md-fences .hljs-literal,
.md-fences .hljs-doctag,
.md-fences .hljs-regexp                                                 { color: {{c:orange}}; }
.md-fences .hljs-string,
.md-fences .hljs-meta .hljs-meta-string                                 { color: {{c:green}}; }
.md-fences .hljs-title,
.md-fences .hljs-section,
.md-fences .hljs-name                                                   { color: {{c:blue}}; font-weight: 600; }
.md-fences .hljs-type,
.md-fences .hljs-class .hljs-title                                      { color: {{c:cyan}}; }
.md-fences .hljs-attribute,
.md-fences .hljs-attr,
.md-fences .hljs-template-variable,
.md-fences .hljs-variable                                               { color: {{c:yellow}}; }
.md-fences .hljs-built_in,
.md-fences .hljs-builtin-name                                           { color: {{c:cyan}}; }
.md-fences .hljs-symbol,
.md-fences .hljs-bullet,
.md-fences .hljs-meta,
.md-fences .hljs-meta .hljs-keyword,
.md-fences .hljs-selector-attr,
.md-fences .hljs-selector-pseudo                                        { color: {{c:magenta}}; }
.md-fences .hljs-deletion                                               { color: {{c:red}}; }
.md-fences .hljs-link                                                   { color: {{c:blue}}; text-decoration: underline; }
.md-fences .hljs-selector-id                                            { color: {{c:blue}}; }
.md-fences .hljs-selector-class                                         { color: {{c:green}}; }
.md-fences .hljs-subst                                                  { color: {{c:fg}}; }
.md-fences .hljs-formula                                                { color: {{c:magenta}}; font-style: italic; }
.md-fences .hljs-params                                                 { color: {{c:orange}}; }
.md-fences .hljs-function                                               { color: {{c:blue}}; }
.md-fences .hljs-emphasis                                               { font-style: italic; }
.md-fences .hljs-strong                                                 { font-weight: bold; }

/* ============================================================
 * CodeMirror Editor Syntax
 * ============================================================ */

.md-fences .cm-s-inner                    { color: {{c:fg}}; }
.md-fences .cm-s-inner .cm-comment       { color: {{c:comment}}; font-style: italic; }
.md-fences .cm-s-inner .cm-string,
.md-fences .cm-s-inner .cm-string-2      { color: {{c:green}}; }
.md-fences .cm-s-inner .cm-keyword       { color: {{c:magenta}}; }
.md-fences .cm-s-inner .cm-builtin       { color: {{c:cyan}}; }
.md-fences .cm-s-inner .cm-variable,
.md-fences .cm-s-inner .cm-variable-2,
.md-fences .cm-s-inner .cm-variable-3    { color: {{c:fg}}; }
.md-fences .cm-s-inner .cm-number,
.md-fences .cm-s-inner .cm-atom          { color: {{c:orange}}; }
.md-fences .cm-s-inner .cm-operator      { color: {{c:cyan}}; }
.md-fences .cm-s-inner .cm-def           { color: {{c:blue}}; }
.md-fences .cm-s-inner .cm-tag           { color: {{c:red}}; }
.md-fences .cm-s-inner .cm-attribute     { color: {{c:yellow}}; }
.md-fences .cm-s-inner .cm-property      { color: {{c:green}}; }
.md-fences .cm-s-inner .cm-meta,
.md-fences .cm-s-inner .cm-meta-string   { color: {{c:magenta}}; }
.md-fences .cm-s-inner .cm-qualifier     { color: {{c:green}}; }
.md-fences .cm-s-inner .cm-type          { color: {{c:cyan}}; }
.md-fences .cm-s-inner .cm-error         { color: {{c:red}}; background: transparent; }
.md-fences .cm-s-inner .cm-header        { color: {{c:blue}}; font-weight: bold; }
.md-fences .cm-s-inner .cm-link          { color: {{c:blue}}; text-decoration: underline; }

/* ============================================================
 * Search — every hit tinted with the theme's search hue; the current hit
 * is solid via --search-select-bg-color / --search-select-text-color.
 * ============================================================ */

.md-search-hit,
.cm-search-hit { background-color: rgba({{rgb:search}}, 0.25); }

/* ============================================================
 * Print / PDF Export
 * ============================================================ */

@media print {
    body { font-size: 11pt; line-height: 1.7; }
    #write { max-width: 100%; padding: 0; }

    a { border-bottom: none; text-decoration: underline; }

    h1, h2, h3, h4, h5, h6 { page-break-after: avoid; break-after: avoid; }
    pre, .md-fences, blockquote, img, table { page-break-inside: avoid; break-inside: avoid; }

    .md-toc { display: none; }
}
